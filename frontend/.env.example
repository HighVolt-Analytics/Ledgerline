# Copy to .env.local for local Vite (never commit secrets).
# OpenReplay — Preferences → Projects in the OpenReplay dashboard.

VITE_OPEN_REPLAY_PROJECT_KEY=
# Optional self-hosted ingest URL (cloud can leave empty)
# VITE_OPEN_REPLAY_INGEST_POINT=https://api.openreplay.com/ingest

# 0 = plain, 1 = obscured, 2 = ignored
VITE_OPEN_REPLAY_DEFAULT_INPUT_MODE=2
VITE_OPEN_REPLAY_OBSCURE_TEXT_NUMBERS=false
VITE_OPEN_REPLAY_OBSCURE_TEXT_EMAILS=true

# Capture CSS inline (needed for localhost replays). Cloud/staging often use 3.
VITE_OPEN_REPLAY_INLINE_CSS=3

# true for http://localhost; false/omit on HTTPS deployments
VITE_OPEN_REPLAY_DISABLE_SECURE_MODE=true

# Live remote assist (cobrowse)
VITE_OPEN_REPLAY_ASSIST_ENABLED=true

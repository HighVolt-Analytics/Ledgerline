{
  "schema_version": 1,
  "email_capture_rules": [
    {
      "id": "ec-employee-bypass",
      "name": "Employee registry attachments",
      "enabled": true,
      "priority": 100,
      "mailbox": "*",
      "root": {
        "type": "group",
        "operator": "OR",
        "children": [
          {
            "type": "condition",
            "field": "attachment_name",
            "operator": "ends_with",
            "value": ".pdf"
          },
          {
            "type": "condition",
            "field": "attachment_name",
            "operator": "ends_with",
            "value": ".jpg"
          },
          {
            "type": "condition",
            "field": "attachment_name",
            "operator": "ends_with",
            "value": ".jpeg"
          },
          {
            "type": "condition",
            "field": "attachment_name",
            "operator": "ends_with",
            "value": ".png"
          },
          {
            "type": "condition",
            "field": "attachment_name",
            "operator": "ends_with",
            "value": ".docx"
          }
        ]
      },
      "action": {
        "save_attachment": true,
        "route_to": "Team Expenses",
        "tags": []
      },
      "requires_employee_sender": true,
      "matched_count": 0,
      "last_matched": ""
    }
  ],
  "purchase_rules": [],
  "expense_rules": [],
  "team_expense_rules": [],
  "vendor_masters": [],
  "vendor_detection_config": {
    "weights": {
      "name": 30,
      "abn": 40,
      "bank": 20,
      "address": 10
    },
    "threshold": 70
  },
  "employee_masters": [],
  "posting_defaults": {
    "tax_account": "GST Paid",
    "payable_account": "Accounts Payable",
    "fallback_account": "Suspense Account"
  },
  "document_sets": [],
  "legacy_cascade": {
    "enabled": true,
    "priority_order": ["po_code", "doc_code", "vendor", "keyword"],
    "po_codes": {},
    "po_code_isolated": {},
    "doc_codes": [],
    "vendors": {},
    "vendor_isolated": {},
    "keywords": {},
    "keyword_isolated": {}
  }
}

{
  "schema_version": 1,
  "email_capture_rules": [
    {
      "id": "ec-1",
      "name": "AWS billing",
      "enabled": true,
      "priority": 1,
      "mailbox": "accounts@acme-hospitality.com.au",
      "root": {
        "type": "group",
        "operator": "AND",
        "children": [
          {
            "type": "condition",
            "field": "from",
            "operator": "contains",
            "value": "billing@amazon"
          },
          {
            "type": "condition",
            "field": "subject",
            "operator": "contains",
            "value": "invoice"
          },
          {
            "type": "condition",
            "field": "attachment_name",
            "operator": "ends_with",
            "value": ".pdf"
          }
        ]
      },
      "action": {
        "save_attachment": true,
        "route_to": "Purchase Management",
        "tags": [
          "AWS",
          "Cloud"
        ]
      },
      "matched_count": 24,
      "last_matched": "2h ago"
    },
    {
      "id": "ec-2",
      "name": "Supplier invoices (Sysco / Bidfood / PFD)",
      "enabled": true,
      "priority": 2,
      "mailbox": "accounts@acme-hospitality.com.au",
      "root": {
        "type": "group",
        "operator": "OR",
        "children": [
          {
            "type": "group",
            "operator": "AND",
            "children": [
              {
                "type": "condition",
                "field": "from",
                "operator": "contains",
                "value": "sysco"
              },
              {
                "type": "condition",
                "field": "attachment_name",
                "operator": "contains",
                "value": "INV"
              }
            ]
          },
          {
            "type": "group",
            "operator": "AND",
            "children": [
              {
                "type": "condition",
                "field": "from",
                "operator": "contains",
                "value": "bidfood"
              },
              {
                "type": "condition",
                "field": "attachment_name",
                "operator": "contains",
                "value": "invoice"
              }
            ]
          },
          {
            "type": "group",
            "operator": "AND",
            "children": [
              {
                "type": "condition",
                "field": "from",
                "operator": "contains",
                "value": "pfd"
              },
              {
                "type": "condition",
                "field": "subject",
                "operator": "contains",
                "value": "Tax Invoice"
              }
            ]
          }
        ]
      },
      "action": {
        "save_attachment": true,
        "route_to": "Purchase Management",
        "tags": [
          "Supplier",
          "F&B"
        ]
      },
      "matched_count": 87,
      "last_matched": "14m ago"
    },
    {
      "id": "ec-3",
      "name": "Team expense receipts via email",
      "enabled": true,
      "priority": 3,
      "mailbox": "expenses@acme-hospitality.com.au",
      "root": {
        "type": "group",
        "operator": "AND",
        "children": [
          {
            "type": "group",
            "operator": "OR",
            "children": [
              {
                "type": "condition",
                "field": "subject",
                "operator": "contains",
                "value": "receipt"
              },
              {
                "type": "condition",
                "field": "subject",
                "operator": "contains",
                "value": "expense claim"
              },
              {
                "type": "condition",
                "field": "subject",
                "operator": "regex",
                "value": "^Fwd:"
              }
            ]
          },
          {
            "type": "condition",
            "field": "attachment_mime",
            "operator": "contains",
            "value": "image/"
          }
        ]
      },
      "action": {
        "save_attachment": true,
        "route_to": "Team Expenses",
        "tags": [
          "receipt"
        ]
      },
      "matched_count": 15,
      "last_matched": "44m ago"
    }
  ],
  "purchase_rules": [
    {
      "id": "pr-1",
      "name": "Cloud & Hosting POs",
      "enabled": true,
      "match_on": {
        "po_prefix": "PO-CLOUD-",
        "grn_linked_to_po": true,
        "invoice_references_po": true

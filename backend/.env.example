# Copy to .env for local development (venv on your machine).
# Docker Compose sets these in docker-compose.yml — you do not need .env for api/worker/beat.

# Use 5433 if Windows PostgreSQL already uses 5432 (see docker-compose postgres ports)
DATABASE_URL=postgresql+asyncpg://invoice:invoice@localhost:5433/invoice_db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
UPLOAD_DIR=./uploads
RULE_BOOK_CONFIG_PATH=./app/rule_book_config.json
CHART_OF_ACCOUNTS_PATH=./app/chart_of_accounts.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# VR05: format = 11-digit ABN (test); checksum = full ATO algorithm + international tax ID
ABN_VALIDATION_MODE=format
# VR02: set true to reject duplicate invoice numbers per vendor (within org)
DUPLICATE_INVOICE_CHECK_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@invoice-pipeline.local

# Phase 1 — Microsoft Graph (Entra app registration; no resource group required)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_MAX_MESSAGES=50
# Celery Beat inbox poll (minutes). Default 2; use 1 for near-real-time, 5–10 for low volume
GRAPH_POLL_INTERVAL_MINUTES=2
GRAPH_FOLDER_MOVES_ENABLED=true
GRAPH_PROCESSED_FOLDER=Processed
GRAPH_EXCEPTIONS_FOLDER=Exceptions

# Phase 1b — Document Intelligence (optional; fallback when local parse is low confidence)
# Aliases: AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT / AZURE_DOCUMENT_INTELLIGENCE_KEY
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_MODEL_ID=prebuilt-invoice
PARSE_MIN_TEXT_CHARS=200

# Phase 2 — Azure Blob Storage (optional; falls back to UPLOAD_DIR when unset)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=invoices
BLOB_AUTO_RELOCATE_UNKNOWN=true
BLOB_AUTO_LEARN_SENDER=true

# Azure PostgreSQL (optional — use instead of local DATABASE_URL)
# POSTGRES_HOST=pg-emailacct-49964.postgres.database.azure.com
# POSTGRES_PORT=5432
# POSTGRES_DB=email_accounting
# POSTGRES_USER=pgadmin
# POSTGRES_PASSWORD=

# Azure Redis / Celery (optional — use instead of local REDIS_URL)
# REDIS_HOST=redis-emailacct-49964.redis.cache.windows.net
# REDIS_SSL_PORT=6380
# REDIS_PASSWORD=

# Azure metadata (optional)
# AZURE_LOCATION=eastus2
# AZURE_RESOURCE_GROUP=rg-email-to-accounting-automation
# AZURE_WEBAPP_URL=https://app-emailacct-49964.azurewebsites.net

# Application Insights (optional; API startup telemetry)
# Disabled locally by default — OpenTelemetry can block uvicorn on Windows.
# Set ENABLE_APPLICATION_INSIGHTS=true to test locally, or deploy to App Service (auto-enables).
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# ENABLE_APPLICATION_INSIGHTS=false

# Auth — JWT login for dashboard (set a long random secret in production)
AUTH_REQUIRED=true
# Run pipeline in-process when Celery/Redis is not running (local dev)
SYNC_PROCESSING=true
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=43200
DEFAULT_ORG_SLUG=hv-org
DEFAULT_ORG_NAME=High Volt Analytics

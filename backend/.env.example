# Copy to .env — never commit .env
# Full Azure mapping: docs/azure-env-mapping.md
# Quick start: README.md (Azure backends recommended)

# -----------------------------------------------------------------------------
# Azure PostgreSQL (recommended — app builds DATABASE_URL with ssl=require)
# Comment out DATABASE_URL below when using these.
# -----------------------------------------------------------------------------
POSTGRES_HOST=pg-emailacct-49964.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=email_accounting
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Azure Redis (recommended — app builds rediss:// broker /0 and results /1)
# Comment out REDIS_URL / CELERY_* below when using these.
# -----------------------------------------------------------------------------
REDIS_HOST=redis-emailacct-49964.redis.cache.windows.net
REDIS_SSL_PORT=6380
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Local Docker fallback (uncomment when using docker compose postgres/redis)
# Use 5433 if Windows PostgreSQL already uses 5432 (see docker-compose ports)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://invoice:invoice@localhost:5433/invoice_db
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

UPLOAD_DIR=./uploads
RULE_BOOK_CONFIG_PATH=./app/rule_book_config.json
# Rule book PUT commits immediately when using the API (safe for reload).
# Timer debounce only applies to internal callers without a request DB session.
RULE_BOOK_SAVE_DEBOUNCE_MS=2000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Clickable vault / invite links (optional — falls back to GRAPH_OAUTH_FRONTEND_RETURN_URL origin)
PUBLIC_APP_URL=http://localhost:5173
# External testing: ngrok http 8001 → set to https://<id>.ngrok-free.dev (overrides PUBLIC_APP_URL + OAuth callback)
# PUBLIC_TUNNEL_URL=https://your-subdomain.ngrok-free.dev
LOG_LEVEL=INFO

# VR05: format = 11-digit ABN (test); checksum = full ATO algorithm + international tax ID
ABN_VALIDATION_MODE=format
# VR02: reject duplicate invoice numbers per vendor (within org); set false to disable
DUPLICATE_INVOICE_CHECK_ENABLED=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@invoice-pipeline.local

# Microsoft Graph (Entra app registration)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_MAX_MESSAGES=50
GRAPH_BACKFILL_MAX_MESSAGES=500
GRAPH_BACKFILL_MAX_DAYS=90
GRAPH_POLL_INTERVAL_MINUTES=2
GRAPH_FOLDER_MOVES_ENABLED=true
GRAPH_PROCESSED_FOLDER=Processed
GRAPH_EXCEPTIONS_FOLDER=Exceptions

# OAuth delegated mailbox connection
GRAPH_OAUTH_REDIRECT_URI=http://localhost:8001/api/mailboxes/oauth/callback
GRAPH_OAUTH_FRONTEND_RETURN_URL=http://localhost:5173/integrations
# Set true only when Entra app is multi-tenant (Accounts in any org directory)
# GRAPH_OAUTH_MULTI_TENANT=false

# Google Gmail OAuth (mailbox invites for @gmail.com / Google Workspace)
# Aliases: GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8001/api/mailboxes/gmail/oauth/callback

# Meta / WhatsApp Cloud API (Team Expenses capture)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_OAUTH_SCOPES=whatsapp_business_management,whatsapp_business_messaging,business_management
# Local: matches FastAPI routes. Staging (AKS/Front Door):
# WHATSAPP_OAUTH_REDIRECT_URI=https://staging.highvolt.tech/ledgerlink/auth/whatsapp/callback
# WHATSAPP_OAUTH_FRONTEND_RETURN_URL=https://staging.highvolt.tech/ledgerlink/integrations
# AZURE_WEBAPP_URL=https://staging.highvolt.tech/ledgerlink
WHATSAPP_OAUTH_REDIRECT_URI=http://localhost:8001/auth/whatsapp/callback
WHATSAPP_OAUTH_FRONTEND_RETURN_URL=http://localhost:5173/integrations

# Xero accounting OAuth (optional — Integrations → Xero)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8001/api/integrations/xero/callback
# XERO_OAUTH_SCOPES=openid profile email accounting.settings.read offline_access
# ACCOUNTING_OAUTH_FRONTEND_RETURN_URL=http://localhost:5173/integrations

# QuickBooks Online accounting OAuth (optional — Integrations → QuickBooks)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8001/api/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox
# QUICKBOOKS_OAUTH_SCOPES=com.intuit.quickbooks.accounting

# Viber Public Account (Team Expenses capture)
# Local dev: ngrok http 8001 → set PUBLIC_TUNNEL_URL (webhook becomes …/webhook/viber automatically)
# Or override explicitly: VIBER_WEBHOOK_URL=https://your-subdomain.ngrok-free.dev/webhook/viber
# VIBER_AUTH_TOKEN=   # optional server default; normally paste token in Integrations UI

# Document Intelligence (fallback when local parse is low confidence)
# Aliases: AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT / AZURE_DOCUMENT_INTELLIGENCE_KEY
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_MODEL_ID=prebuilt-invoice
AZURE_DI_READ_MODEL_ID=prebuilt-read
AZURE_DI_LAYOUT_MODEL_ID=prebuilt-layout
PARSE_MIN_TEXT_CHARS=200

# Mixed-bundle PDFs: split on page headings before document-type routing (all capture channels)
PDF_MULTI_DOCUMENT_SPLIT=true
PDF_SEGMENT_MAX_PAGES=200
PDF_SEGMENT_MAX_SEGMENTS=20
PDF_SEGMENT_LLM_ENABLED=true
PDF_SEGMENT_LLM_TIMEOUT_SECONDS=30
PDF_SEGMENT_LLM_PROMPT_VERSION=v1

# Azure OpenAI (optional — sample analysis wizard only)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_FAST_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
SAMPLE_PROPOSAL_LLM_ENABLED=false
SAMPLE_PROPOSAL_LLM_TIMEOUT_SECONDS=30

# Runtime LLM classification + extraction (Azure OpenAI)
RUNTIME_LLM_ENABLED=true
RUNTIME_LLM_MIN_CONFIDENCE=0.85
RUNTIME_LLM_TIMEOUT_SECONDS=45
LINE_GL_LLM_ENABLED=true
LLM_CLASSIFICATION_PROMPT_VERSION=v2

# Vision LLM — Azure AI Foundry (GPT-4o with vision) or Gemini (legacy)
VISION_LLM_PROVIDER=azure_foundry
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-4o
AZURE_AI_FOUNDRY_API_VERSION=2024-08-01-preview

# Google Gemini Vision (optional legacy document AI provider)
GOOGLE_GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# Azure Blob Storage (falls back to UPLOAD_DIR when unset)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=invoices
BLOB_AUTO_RELOCATE_UNKNOWN=true
BLOB_AUTO_LEARN_SENDER=true

# Azure metadata (Integrations UI / optional)
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-email-to-accounting-automation
AZURE_WEBAPP_URL=https://app-emailacct-49964.azurewebsites.net

# Application Insights (optional locally; auto on App Service)
# Set ENABLE_APPLICATION_INSIGHTS=true to test OpenTelemetry on Windows.
APPLICATIONINSIGHTS_CONNECTION_STRING=
ENABLE_APPLICATION_INSIGHTS=false

# OAuth login / signup (separate redirect URIs from mailbox integrations)
# Google login callback: http://localhost:8001/api/auth/oauth/google/callback
# Microsoft SPA callback: http://localhost:5173/login/oauth/callback
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:5173/login/oauth/callback
MICROSOFT_OAUTH_PUBLIC_CLIENT=true
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/api/auth/oauth/google/callback
FRONTEND_URL=http://localhost:5173

# Auth — JWT login for dashboard
AUTH_REQUIRED=true
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=43200
# Super-admin portal embed (external site button → auto-login; treat token like a password)
# SUPER_ADMIN_PORTAL_EMBED_TOKEN=ll_pe_your-secret-token-here
# SUPER_ADMIN_PORTAL_EMBED_EMAIL=vishnu@highvolt.tech
# Optional: restrict which external sites may call portal-embed login
# SUPER_ADMIN_PORTAL_EMBED_ALLOWED_ORIGINS=https://highvolt.tech,https://www.highvolt.tech
DEFAULT_ORG_SLUG=hv-org
DEFAULT_ORG_NAME=High Volt Analytics

# Run pipeline in-process when Celery/Redis is not running (local dev only)
SYNC_PROCESSING=true

# Reverse-proxy path prefix (AKS / Azure Front Door). Leave unset for local dev.
# Staging: https://staging.highvolt.tech/ledgerlink -> BASE_PATH=/ledgerlink, API_BASE_PATH=/ledgerlink/api
# Production: https://ledgerlink.highvolt.tech -> BASE_PATH=/ (or unset), API_BASE_PATH=/api
# BASE_PATH=/ledgerlink
# API_BASE_PATH=/api
# ROOT_PATH=/ledgerlink

# Stripe Connect / payments (optional — leave empty until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_MODE=sandbox
STRIPE_RETURN_URL=http://localhost:5173/payments
STRIPE_REFRESH_URL=http://localhost:5173/payments
# OAuth redirect for Connect existing Standard accounts (register in Stripe Connect/OAuth settings)
STRIPE_OAUTH_REDIRECT_URL=http://localhost:5173/payments/stripe/oauth/callback
# Production safety — keep false until UAT/security/business signoff and live keys are approved
STRIPE_PAYMENTS_EXECUTION_ENABLED=false
STRIPE_LIVE_PAYMENTS_ENABLED=false
# Manual payment instruction orchestration (no Stripe money movement)
PAYMENT_MANUAL_EXECUTION_ENABLED=false
PAYMENT_MANUAL_EXECUTION_LIMIT_USD=1000
# Emergency kill switch for all execution instruction / mark-paid endpoints
PAYMENT_EXECUTION_DISABLED=false

# Environment labels (preview vs production)
APP_ENV=development
ENVIRONMENT=development
PAYMENT_ENVIRONMENT_LABEL=
PUBLIC_APP_BASE_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8001/api

# Stripe Global Payouts (configuration only — no outbound payment APIs until approved)
STRIPE_GLOBAL_PAYOUTS_ENABLED=false
STRIPE_GLOBAL_PAYOUTS_ACCESS_STATUS=not_requested
STRIPE_GLOBAL_PAYOUTS_FINANCIAL_ACCOUNT_ID=
STRIPE_GLOBAL_PAYOUTS_WEBHOOK_SECRET=
STRIPE_GLOBAL_PAYOUTS_MAX_AMOUNT_USD=1000
STRIPE_GLOBAL_PAYOUTS_SUPPORTED_COUNTRIES=AU
STRIPE_GLOBAL_PAYOUTS_SUPPORTED_CURRENCIES=AUD,USD

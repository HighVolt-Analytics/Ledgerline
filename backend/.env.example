# Copy to .env — never commit .env
# Full Azure mapping: docs/azure-env-mapping.md
# Quick start: README.md (Azure backends recommended)

# -----------------------------------------------------------------------------
# Azure PostgreSQL (recommended — app builds DATABASE_URL with ssl=require)
# Comment out DATABASE_URL below when using these.
# -----------------------------------------------------------------------------
POSTGRES_HOST=pg-emailacct-49964.postgres.database.azure.com
POSTGRES_PORT=5432
POSTGRES_DB=email_accounting
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Azure Redis (recommended — app builds rediss:// broker /0 and results /1)
# Comment out REDIS_URL / CELERY_* below when using these.
# -----------------------------------------------------------------------------
REDIS_HOST=redis-emailacct-49964.redis.cache.windows.net
REDIS_SSL_PORT=6380
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Local Docker fallback (uncomment when using docker compose postgres/redis)
# Use 5433 if Windows PostgreSQL already uses 5432 (see docker-compose ports)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://invoice:invoice@localhost:5433/invoice_db
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

UPLOAD_DIR=./uploads
RULE_BOOK_CONFIG_PATH=./app/rule_book_config.json
CHART_OF_ACCOUNTS_PATH=./app/chart_of_accounts.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Clickable vault / invite links (optional — falls back to GRAPH_OAUTH_FRONTEND_RETURN_URL origin)
PUBLIC_APP_URL=http://localhost:5173
# External testing: ngrok http 8001 → set to https://<id>.ngrok-free.dev (overrides PUBLIC_APP_URL + OAuth callback)
# PUBLIC_TUNNEL_URL=https://your-subdomain.ngrok-free.dev
LOG_LEVEL=INFO

# VR05: format = 11-digit ABN (test); checksum = full ATO algorithm + international tax ID
ABN_VALIDATION_MODE=format
# VR02: reject duplicate invoice numbers per vendor (within org); set false to disable
DUPLICATE_INVOICE_CHECK_ENABLED=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@invoice-pipeline.local

# Microsoft Graph (Entra app registration)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_MAX_MESSAGES=50
GRAPH_BACKFILL_MAX_MESSAGES=500
GRAPH_BACKFILL_MAX_DAYS=90
GRAPH_POLL_INTERVAL_MINUTES=2
GRAPH_FOLDER_MOVES_ENABLED=true
GRAPH_PROCESSED_FOLDER=Processed
GRAPH_EXCEPTIONS_FOLDER=Exceptions

# OAuth delegated mailbox connection
GRAPH_OAUTH_REDIRECT_URI=http://localhost:8001/api/mailboxes/oauth/callback
GRAPH_OAUTH_FRONTEND_RETURN_URL=http://localhost:5173/integrations
# Set true only when Entra app is multi-tenant (Accounts in any org directory)
# GRAPH_OAUTH_MULTI_TENANT=false

# Google Gmail OAuth (mailbox invites for @gmail.com / Google Workspace)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8001/api/mailboxes/gmail/oauth/callback

# Meta / WhatsApp Cloud API (Team Expenses capture)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_OAUTH_SCOPES=whatsapp_business_management,whatsapp_business_messaging,business_management
# Local: matches FastAPI routes. Staging (AKS/Front Door):
# WHATSAPP_OAUTH_REDIRECT_URI=https://staging.highvolt.tech/ledgerlink/auth/whatsapp/callback
# WHATSAPP_OAUTH_FRONTEND_RETURN_URL=https://staging.highvolt.tech/ledgerlink/integrations
# AZURE_WEBAPP_URL=https://staging.highvolt.tech/ledgerlink
WHATSAPP_OAUTH_REDIRECT_URI=http://localhost:8001/auth/whatsapp/callback
WHATSAPP_OAUTH_FRONTEND_RETURN_URL=http://localhost:5173/integrations

# Document Intelligence (fallback when local parse is low confidence)
# Aliases: AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT / AZURE_DOCUMENT_INTELLIGENCE_KEY
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_MODEL_ID=prebuilt-invoice
AZURE_DI_READ_MODEL_ID=prebuilt-read
AZURE_DI_LAYOUT_MODEL_ID=prebuilt-layout
PARSE_MIN_TEXT_CHARS=200

# Azure OpenAI (optional — sample analysis wizard only)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_FAST_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
SAMPLE_PROPOSAL_LLM_ENABLED=false
SAMPLE_PROPOSAL_LLM_TIMEOUT_SECONDS=30

# Azure Blob Storage (falls back to UPLOAD_DIR when unset)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=invoices
BLOB_AUTO_RELOCATE_UNKNOWN=true
BLOB_AUTO_LEARN_SENDER=true

# Azure metadata (Integrations UI / optional)
AZURE_LOCATION=eastus2
AZURE_RESOURCE_GROUP=rg-email-to-accounting-automation
AZURE_WEBAPP_URL=https://app-emailacct-49964.azurewebsites.net

# Application Insights (optional locally; auto on App Service)
# Set ENABLE_APPLICATION_INSIGHTS=true to test OpenTelemetry on Windows.
APPLICATIONINSIGHTS_CONNECTION_STRING=
ENABLE_APPLICATION_INSIGHTS=false

# Auth — JWT login for dashboard
AUTH_REQUIRED=true
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=43200
DEFAULT_ORG_SLUG=hv-org
DEFAULT_ORG_NAME=High Volt Analytics

# Run pipeline in-process when Celery/Redis is not running (local dev only)
SYNC_PROCESSING=true

# Reverse-proxy path prefix (AKS / Azure Front Door). Leave unset for local dev.
# Public URL https://staging.highvolt.tech/ledgerlink -> BASE_PATH=/ledgerlink
# BASE_PATH=/ledgerlink
# ROOT_PATH=/ledgerlink

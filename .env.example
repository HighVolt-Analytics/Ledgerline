# Public Turnstile site key (never the secret key).
# VITE_TURNSTILE_SITE_KEY=

# Booking v2 (site=ledgerline). Keep VITE_BOOKING_V2_ENABLED unset/false until
# BOOKING_V2_ENABLED_LEDGERLINE and BOOKING_ORIGINS_LEDGERLINE are verified on the shared API.
# VITE_BOOKING_V2_ENABLED=false
# VITE_BOOKING_V2_API_BASE=https://<v2-function-app-host>
